package rules;

import com.ftn.sbnz.sv10.model.models.ServiceWorks;
import com.ftn.sbnz.sv10.model.models.ServiceDependsOn;

// ============================================================
// BACKWARD CHAINING
// Pita se "da li je $service dostupan?".
//
// BAZNI SLUCAJ:    postoji direktan dokaz ServiceWorks($service)
//
// REKURZIVNI:      nema direktnog dokaza, ali servis IMA zavisnosti
//                  I NIJEDNA zavisnost nije nedostupna
//                  (tj. SVE zavisnosti su dostupne)
//
// Kljucna razlika u odnosu na naivnu verziju: koristimo negaciju
// "ne postoji zavisnost koja nije dostupna" da bismo zahtevali da
// SVE zavisnosti rade, a ne samo jedna.
// ============================================================

query "isAvailable"(String service)
    ServiceWorks(service == $service := service)
    or
    (
        not ServiceWorks(service == $service := service)
        and exists ServiceDependsOn(service == $service := service)
        and not (
            ServiceDependsOn(service == $service := service, $dep : dependency)
            and not isAvailable($dep;)
        )
    )
end
